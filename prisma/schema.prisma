generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STAFF
  ADMIN
}

enum ShiftStatus {
  OPEN
  ASSIGNED
  CLOSED
  CANCELLED
}

enum BidStatus {
  PENDING
  SELECTED
  NOT_SELECTED
}

enum BidDurationScope {
  FULL
  PARTIAL
}

enum NotificationType {
  NEW_SHIFT
  BID_SUBMITTED
  BID_SELECTED
  BID_NOT_SELECTED
  SHIFT_CANCELLED
  CALLOUT_ESCALATED
  CALLOUT_REMINDER
  AVAILABILITY_UPDATED
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  TENTATIVE
}

enum Channel {
  EMAIL
  SMS
  VOICE
  IN_APP
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  ANSWERED
}

enum OutreachResponse {
  ACCEPTED
  DECLINED
}

/// Lifecycle of a tiered callout cascade. Postgres - not Inngest - is the source
/// of truth: a scheduler "stop" writes CANCELLED here and any running engine step
/// re-reads this and no-ops, which is what keeps the engine swappable.
enum CampaignStatus {
  RUNNING
  PAUSED
  CANCELLED
  FILLED
  EXHAUSTED
}

/// SWAP is a two-way trade (the requester picks a specific shift they receive
/// back); GIVEAWAY is one-way (receiveShiftId stays null).
enum ShiftSwapKind {
  SWAP
  GIVEAWAY
}

/// The three-step pipeline this model tracks: requester submits
/// (PENDING_ACCEPT), the target colleague responds (ACCEPTED/REJECTED), then
/// - only after ACCEPTED - a manager decides (PENDING_APPROVAL ->
/// APPROVED/DENIED). CANCELLED is the requester withdrawing at any point
/// before a terminal state. No `Shift.assignedWorkerId` changes until
/// APPROVED - that reassignment is the accept/approve follow-up task's job.
enum ShiftSwapStatus {
  PENDING_ACCEPT
  ACCEPTED
  REJECTED
  PENDING_APPROVAL
  APPROVED
  DENIED
  CANCELLED
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  password        String
  role            Role      @default(STAFF)
  image           String?
  department      String?
  position        String?
  phone           String?
  hireDate        DateTime?
  seniorityRank   Int?
  phoneVerifiedAt DateTime?
  hospitalId      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hospital              Hospital?              @relation(fields: [hospitalId], references: [id])
  bids                  ShiftBid[]
  assignedShifts        Shift[]                @relation("AssignedWorker")
  createdShifts         Shift[]                @relation("CreatedBy")
  notifications         Notification[]
  activities            ShiftActivity[]        @relation("ActivityActor")
  departmentMemberships DepartmentMembership[]
  availabilities        Availability[]
  outreachAttempts      OutreachAttempt[]
  swapRequestsMade      ShiftSwapRequest[]     @relation("SwapRequester")
  swapRequestsReceived  ShiftSwapRequest[]     @relation("SwapTarget")
  swapRequestsApproved  ShiftSwapRequest[]     @relation("SwapApprovedBy")

  accounts Account[]
  sessions Session[]
}

model Hospital {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  departments Department[]
  shifts      Shift[]
}

model Department {
  id        String  @id @default(cuid())
  name      String
  code      String  @unique
  iconKey   String  @default("star")
  wing      String?
  sortOrder Int     @default(0)

  hospitalId String?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])

  memberships    DepartmentMembership[]
  shifts         Shift[]
  availabilities Availability[]
}

model DepartmentMembership {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String

  @@unique([departmentId, userId])
  @@index([userId])
}

model Shift {
  id            String      @id @default(cuid())
  title         String
  unit          String
  departmentId  String
  department    Department  @relation(fields: [departmentId], references: [id])
  roleNeeded    String
  location      String
  // Short, human-typeable code used to resolve an inbound SMS reply back to this
  // shift (e.g. "reply YES 7K2M"). Null on shifts posted before Phase 3 outreach.
  smsCode       String?     @unique
  startsAt      DateTime
  endsAt        DateTime
  bidDeadlineAt DateTime
  notes         String?
  status        ShiftStatus @default(OPEN)

  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  assignedWorkerId String?
  assignedWorker   User?   @relation("AssignedWorker", fields: [assignedWorkerId], references: [id])

  hospitalId String?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])

  bids                 ShiftBid[]
  notifications        Notification[]
  activities           ShiftActivity[]
  outreachAttempts     OutreachAttempt[]
  campaign             CalloutCampaign?
  swapRequestsGiven    ShiftSwapRequest[] @relation("SwapGiveShift")
  swapRequestsReceived ShiftSwapRequest[] @relation("SwapReceiveShift")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([startsAt])
  @@index([status])
}

model ShiftBid {
  id              String           @id @default(cuid())
  shiftId         String
  shift           Shift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  workerId        String
  worker          User             @relation(fields: [workerId], references: [id])
  note            String?
  hourlyRate      Decimal?         @db.Decimal(10, 2)
  durationScope   BidDurationScope @default(FULL)
  partialStartsAt DateTime?
  partialEndsAt   DateTime?
  status          BidStatus        @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([shiftId, workerId])
}

/// A requester-initiated Shift Swap (two-way trade, `receiveShiftId` set) or
/// Shift Giveaway (one-way, `receiveShiftId` always null). Foundation model
/// only: this phase creates rows in PENDING_ACCEPT and never touches
/// `Shift.assignedWorkerId` - the accept/reject, approve/deny, and resulting
/// reassignment are the accept/approve follow-up's job. See
/// `src/lib/shift-swap/` for the pure eligibility/pay-period rules and
/// `src/app/actions/shift-swap.ts` for the requester-side flow.
model ShiftSwapRequest {
  id String @id @default(cuid())

  requesterId String
  requester   User   @relation("SwapRequester", fields: [requesterId], references: [id])

  giveShiftId String
  giveShift   Shift  @relation("SwapGiveShift", fields: [giveShiftId], references: [id], onDelete: Cascade)

  kind ShiftSwapKind

  targetUserId String
  targetUser   User   @relation("SwapTarget", fields: [targetUserId], references: [id])

  /// The specific shift on targetUser's schedule the requester receives in
  /// exchange. Set only for SWAP; always null for GIVEAWAY.
  receiveShiftId String?
  receiveShift   Shift?  @relation("SwapReceiveShift", fields: [receiveShiftId], references: [id], onDelete: Cascade)

  status ShiftSwapStatus @default(PENDING_ACCEPT)

  requestedAt DateTime  @default(now())
  respondedAt DateTime?

  approvedById String?
  approvedBy   User?     @relation("SwapApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterId])
  @@index([targetUserId])
  @@index([giveShiftId])
  @@index([receiveShiftId])
  @@index([status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  shiftId   String?
  shift     Shift?           @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
}

model ShiftActivity {
  id        String   @id @default(cuid())
  shiftId   String
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation("ActivityActor", fields: [actorId], references: [id])
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model Availability {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department?        @relation(fields: [departmentId], references: [id])
  startsAt     DateTime
  endsAt       DateTime
  status       AvailabilityStatus @default(AVAILABLE)
  createdAt    DateTime           @default(now())

  @@index([userId, startsAt])
  @@index([departmentId, startsAt])
}

model OutreachAttempt {
  id                String            @id @default(cuid())
  shiftId           String
  shift             Shift             @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  userId            String
  user              User              @relation(fields: [userId], references: [id])
  channel           Channel
  /// Cascade tier this attempt belongs to (1-3). 0 = untiered outreach, i.e. a
  /// direct dispatch outside a CalloutCampaign.
  tier              Int               @default(0)
  status            DeliveryStatus    @default(QUEUED)
  response          OutreachResponse?
  providerMessageId String?
  respondedAt       DateTime?
  createdAt         DateTime          @default(now())

  /// Idempotency key for the cascade: re-running a tier must never re-contact
  /// someone the tier already reached on that channel.
  @@unique([shiftId, tier, userId, channel])
  @@index([shiftId])
  @@index([providerMessageId])
}

/// One tiered callout cascade per shift. Holds the authoritative campaign state
/// that both the scheduler controls and the Inngest engine read and write.
model CalloutCampaign {
  id      String @id @default(cuid())
  shiftId String @unique
  shift   Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  currentTier Int            @default(1)
  status      CampaignStatus @default(RUNNING)

  /// How long each tier stays open before the cascade widens. Per-campaign so a
  /// scheduler-configurable or department-specific policy can vary them later.
  tier1WindowMinutes Int @default(15)
  tier2WindowMinutes Int @default(20)
  tier3WindowMinutes Int @default(30)

  /// When the opening (tier-1) outreach becomes due. A freshly posted shift sets
  /// this a short delay ahead of now instead of paging anyone immediately, so a
  /// mis-posted shift can be pulled before a single SMS or call lands. It is
  /// CLEARED the moment tier-1 goes out, so `tier1DispatchAt != null` is exactly
  /// "nobody has been contacted yet" - the flag the durable timer acts on.
  tier1DispatchAt DateTime?

  startedAt      DateTime  @default(now())
  tier1EnteredAt DateTime?
  tier2EnteredAt DateTime?
  tier3EnteredAt DateTime?
  filledAt       DateTime?
  endedAt        DateTime?

  /// Set once when the shift start passes with the shift still unfilled. We raise
  /// a scheduler reminder instead of auto-expiring the callout.
  pastStartReminderAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  hospitalId String?
  actorId    String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([hospitalId, createdAt])
  @@index([targetType, targetId])
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
