# Copy to .env and adjust. Defaults match docker-compose Postgres.

DATABASE_URL="postgresql://staffly:staffly_pass@localhost:5432/staffly_db"

# Required. Generate with:
#   openssl rand -base64 32
# A *present* empty string ("" or unset-but-declared) is worse than just
# missing: NextAuth falls back to auto-deriving a secret in development, but
# that auto-derived value differs between the API route bundle and the page
# bundle in the App Router, so a login silently fails to survive the very
# first page navigation (bounces back to /login, no error shown). Never rely
# on the fallback here - always set a real value.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

RESEND_API_KEY=""
EMAIL_FROM="Staffly <noreply@yourdomain.com>"

# Twilio (multi-channel outreach: SMS + automated voice + phone verification).
# ALL OPTIONAL: with these unset, SMS/voice/verification are skipped and the app
# still runs on email + in-app alerts. Never expose TWILIO_AUTH_TOKEN client-side.
TWILIO_ACCOUNT_SID=""          # Account SID (starts with "AC...")
TWILIO_AUTH_TOKEN=""           # Auth token; also validates inbound webhook signatures
TWILIO_PHONE_NUMBER=""         # Sending number in E.164, e.g. +14165551234
TWILIO_VERIFY_SERVICE_SID=""   # Verify service SID (starts with "VA...") for phone OTP
# Public base URL Twilio uses to reach the webhooks. Defaults to NEXTAUTH_URL;
# set this when the public callback host differs (e.g. an ngrok tunnel in dev).
TWILIO_WEBHOOK_BASE_URL=""

# Inngest (durable timers for the tiered callout cascade).
# BOTH OPTIONAL: with these unset the app runs normally - posting a shift still
# fires tier-1 outreach, and a scheduler can still advance/hold/stop the cascade
# by hand. What is off is everything that needs a clock: the AUTOMATIC timed
# escalation, the past-start reminder, and the ~1 minute hold before tier-1
# outreach (unset, posting dispatches at once). Campaign state lives in Postgres
# either way. SET THESE IN ANY REAL DEPLOYMENT - the posting delay is a safety
# net against a mis-posted shift paging staff, and it needs a durable timer.
INNGEST_EVENT_KEY=""     # publish key, from the Inngest dashboard
INNGEST_SIGNING_KEY=""   # signs Inngest's calls to /api/inngest (starts "signkey-")

# Health check (GET /api/health, the uptime monitor's target).
# OPTIONAL: without it /api/health still answers {"status":"ok"|"degraded"}
# (200/503). With it set, a request sending the header
#   X-Health-Token: <this value>
# also gets the per-check breakdown (DB + latency, running region, which
# required config is present, build version) - booleans and statuses only,
# never a config value. Generate with: openssl rand -base64 32
HEALTH_CHECK_TOKEN=""
# Residency guard: when set (prod: "yul1"), /api/health reports degraded if the
# function is not running in this Vercel region (VERCEL_REGION).
REQUIRED_FUNCTION_REGION=""
